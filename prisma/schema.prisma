generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Enums ──────────────────────────────────────────────────────

enum Role {
  OWNER
  USER
  ARTIST
}

enum DesignStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  DRAFT
  PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductType {
  TSHIRT
  LONG_SLEEVE
  HOODIE
  HOODIE_VEST
  SOCKS
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

// ── Models ─────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String?
  role        Role     @default(USER)

  shipStreet  String?
  shipCity    String?
  shipState   String?
  shipZip     String?

  aiProfile   String?

  createdAt     DateTime       @default(now())
  orders        Order[]
  artistDesigns ArtistDesign[]
  subscriptions Subscription[]
}

model ArtistDesign {
  id          String       @id @default(cuid())
  artistId    String
  artist      Customer     @relation(fields: [artistId], references: [id])

  title       String
  category    String
  productType ProductType  @default(TSHIRT)
  price       Float        @default(29.99)
  svg         String
  badge       String?

  status      DesignStatus @default(PENDING)

  salesCount  Int   @default(0)
  totalEarned Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Subscription {
  id             String             @id @default(cuid())
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id])
  status         SubscriptionStatus @default(ACTIVE)
  // JSON: { style, productTypes, size, colorPref }
  stylePrefs     String
  nextShipmentAt DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  shipments      SubscriptionShipment[]
}

model SubscriptionShipment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id])
  // PENDING | SHIPPED | DELIVERED
  status         String       @default("PENDING")
  // JSON array of items
  items          String
  shippedAt      DateTime?
  createdAt      DateTime     @default(now())
}

model DesignAsset {
  id             String      @id @default(cuid())
  title          String
  emoji          String?
  customText     String?
  colorHex       String
  colorName      String
  size           String
  filePath       String?
  svgDataUrl     String?
  artistDesignId String?
  createdAt      DateTime    @default(now())
  orderItems     OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  customer      Customer    @relation(fields: [customerId], references: [id])
  customerId    String
  status        OrderStatus @default(DRAFT)
  total         Float
  shippingName  String
  shippingAddr  String
  shippingCity  String
  shippingZip   String
  shippingState String
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]
}

model OrderItem {
  id            String      @id @default(cuid())
  order         Order       @relation(fields: [orderId], references: [id])
  orderId       String
  designAsset   DesignAsset @relation(fields: [designAssetId], references: [id])
  designAssetId String
  qty           Int         @default(1)
  unitPrice     Float
}
