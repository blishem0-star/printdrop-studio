generator client {
  provider = "prisma-client-js"
  output   = "../lib/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ── Enums ──────────────────────────────────────────────────────

enum Role {
  OWNER
  USER
  ARTIST
}

enum DesignStatus {
  PENDING
  APPROVED
  REJECTED
}

enum OrderStatus {
  DRAFT
  PAID
  IN_PRODUCTION
  SHIPPED
  DELIVERED
  CANCELLED
}

enum ProductType {
  TSHIRT
  LONG_SLEEVE
  HOODIE
  HOODIE_VEST
  SOCKS
}

enum SubscriptionStatus {
  ACTIVE
  PAUSED
  CANCELLED
}

// ── Models ─────────────────────────────────────────────────────

model Customer {
  id          String   @id @default(cuid())
  name        String
  email       String   @unique
  password    String?
  role        Role     @default(USER)

  shipStreet  String?
  shipCity    String?
  shipState   String?
  shipZip     String?

  aiProfile   String?

  createdAt     DateTime       @default(now())
  orders        Order[]
  artistDesigns ArtistDesign[]
  subscriptions Subscription[]
}

model ArtistDesign {
  id          String       @id @default(cuid())
  artistId    String
  artist      Customer     @relation(fields: [artistId], references: [id], onDelete: Cascade)

  title       String
  category    String
  productType ProductType  @default(TSHIRT)
  price       Float        @default(29.99)
  svg         String
  badge       String?

  status      DesignStatus @default(PENDING)

  salesCount  Int   @default(0)
  totalEarned Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([artistId])
  @@index([status])
}

model Subscription {
  id             String             @id @default(cuid())
  customerId     String
  customer       Customer           @relation(fields: [customerId], references: [id], onDelete: Cascade)
  status         SubscriptionStatus @default(ACTIVE)
  // JSON: { style, productTypes, size, colorPref }
  stylePrefs     String
  nextShipmentAt DateTime
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt
  shipments      SubscriptionShipment[]

  @@index([customerId])
  @@index([status])
}

model SubscriptionShipment {
  id             String       @id @default(cuid())
  subscriptionId String
  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  // PENDING | SHIPPED | DELIVERED
  status         String       @default("PENDING")
  // JSON array of items
  items          String
  shippedAt      DateTime?
  createdAt      DateTime     @default(now())
}

model DesignAsset {
  id             String      @id @default(cuid())
  title          String
  emoji          String?
  customText     String?
  colorHex       String
  colorName      String
  size           String
  filePath       String?
  svgDataUrl     String?
  artistDesignId String?
  createdAt      DateTime    @default(now())
  orderItems     OrderItem[]
}

model Order {
  id            String      @id @default(cuid())
  customer      Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  customerId    String
  status        OrderStatus @default(DRAFT)
  total         Float
  shippingName  String
  shippingAddr  String
  shippingCity  String
  shippingZip   String
  shippingState String
  notes         String?
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
  items         OrderItem[]

  @@index([customerId])
  @@index([status])
  @@index([createdAt])
}

model OrderItem {
  id            String      @id @default(cuid())
  order         Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  orderId       String
  designAsset   DesignAsset @relation(fields: [designAssetId], references: [id])
  designAssetId String
  qty           Int         @default(1)
  unitPrice     Float
}

// Immutable audit trail of privileged admin operations
model AdminAction {
  id         String   @id @default(cuid())
  actorId    String
  actorEmail String
  action     String   // e.g. DESIGN_APPROVED, DESIGN_REJECTED, ORDER_STATUS_CHANGED
  targetType String   // ArtistDesign | Order
  targetId   String
  detail     String?  // free-form, e.g. "PAID -> SHIPPED"
  createdAt  DateTime @default(now())

  @@index([createdAt])
  @@index([targetType, targetId])
}

// Per-account login throttling (in addition to per-IP rate limiting)
model LoginThrottle {
  email        String    @id
  failures     Int       @default(0)
  lockedUntil  DateTime?
  updatedAt    DateTime  @updatedAt
}

// Anonymous product-usage signals that drive data-led catalog growth:
// which categories get favorited, remixed, filtered, and ordered.
model UsageEvent {
  id        String   @id @default(cuid())
  type      String   // favorite | remix | order | filter | studio_start
  category  String?
  designId  String?
  createdAt DateTime @default(now())

  @@index([type, category])
  @@index([createdAt])
}

// One-time password-reset tokens; emailed as a link, valid for 1 hour.
model PasswordReset {
  token      String   @id @default(cuid())
  customerId String
  expiresAt  DateTime
  usedAt     DateTime?
  createdAt  DateTime @default(now())

  @@index([customerId])
}

// Launch/newsletter list - collected locally, exported when email goes live.
model NewsletterSignup {
  id        String   @id @default(cuid())
  email     String   @unique
  source    String   @default("landing")
  createdAt DateTime @default(now())
}

// Percent-off coupon codes (e.g. LAUNCH15). Validated server-side on order
// submission; uses are counted so maxUses caps are enforceable.
model Coupon {
  code      String    @id
  pct       Int
  active    Boolean   @default(true)
  maxUses   Int?
  uses      Int       @default(0)
  expiresAt DateTime?
  createdAt DateTime  @default(now())
}
